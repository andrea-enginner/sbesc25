# Exemplo de configuração do banco MySQL
# Copie este arquivo para .env.local e preencha com suas credenciais

# Opção 1: usar uma URL completa (recomendado quando a senha contém caracteres especiais)
DATABASE_URL=mysql://usuario:senha@host:3306/nome_do_banco

# Opção 2: preencher os campos individuais
DB_HOST=host-do-banco
DB_PORT=3306
DB_USER=usuario
DB_PASSWORD=senha
DB_NAME=nome_do_banco
