# Exemplo de configuração do Firebase Realtime Database
# Copie este arquivo para .env.local e preencha com suas credenciais

# URL do Firebase Realtime Database
# Exemplo: https://seu-projeto-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=https://seu-projeto-default-rtdb.firebaseio.com

# Service Account do Firebase (JSON completo como string)
# Opção 1: Colar o JSON completo da service account como uma string (recomendado)
# IMPORTANTE: Use aspas simples e mantenha o JSON em uma única linha, ou use \n para quebras de linha
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# Opção 2: Caminho para o arquivo JSON da service account (relativo à raiz do projeto)
# FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
